---
import PageLayout from "../layouts/PageLayout.astro";
import { serviceTowns } from "../data/areas";
import IconBadge from "../components/ui/IconBadge.astro";
import Pill from "../components/ui/Pill.astro";
import Section from "../components/ui/Section.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
---

<PageLayout
  title="Service Areas"
  description="Serving industrial manufacturing facilities across Southern New Hampshire since 1983. We cover Chesterfield, Keene, Swanzey, Concord, Lebanon, Newport, and New London."
  keywords="service areas, Chesterfield NH, Keene NH, Swanzey, Concord NH, Lebanon NH, Newport NH, New London NH, Southern New Hampshire commercial cleaning"
>
  <div class="min-h-screen bg-background" data-testid="page-areas">
    <PageHero
      testid="section-areas-hero"
      titleTestid="text-areas-hero-title"
      title="Our Service Areas"
      description="Serving industrial manufacturing facilities across Southern New Hampshire since 1983."
      image="/images/nh-landscape.png"
      minHeight="450px"
      overlay="strong"
    >
      <Pill slot="eyebrow" icon="ph--map-pin" class="bg-sky-500/20 text-sky-200 border-sky-500/30 mb-4">Southern New Hampshire</Pill>
    </PageHero>

    <Section testid="section-towns">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6">
        {serviceTowns.map((town, index) => (
          <a href={`/areas/${town.slug}`} data-testid={`card-town-${index}`}>
            <div class="p-6 text-center rounded-lg border border-slate-200 hover-elevate overflow-visible h-full">
              <IconBadge icon="ph--map-pin" class="w-12 h-12 rounded-full bg-sky-100 mx-auto mb-4" />
              <h3 class="text-lg font-bold text-slate-900">{town.name}</h3>
              <p class="text-sm text-slate-500">{town.county}</p>
            </div>
          </a>
        ))}
      </div>
    </Section>

    <Section background="slate-50" testid="section-focus">
      <div class="max-w-3xl mx-auto text-center">
        <IconBadge icon="ph--factory" class="w-16 h-16 rounded-full bg-sky-100 mx-auto mb-6" iconClass="w-12 h-12 text-sky-600" />
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Industrial Manufacturing Focus</h2>
        <p class="text-lg text-slate-600 mb-8">
          We specialize in maintaining industrial manufacturing facilities with consistent daily cleaning to keep your operations running smoothly.
        </p>
        <div class="grid sm:grid-cols-3 gap-6">
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <p class="text-4xl font-bold text-sky-600 mb-2">40+</p>
            <p class="text-slate-600">Years Experience</p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <p class="text-4xl font-bold text-sky-600 mb-2">Daily</p>
            <p class="text-slate-600">Reliable Service</p>
          </div>
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <p class="text-4xl font-bold text-sky-600 mb-2">7</p>
            <p class="text-slate-600">Communities</p>
          </div>
        </div>
      </div>
    </Section>

    <CtaBand testid="section-areas-cta" primaryTestid="button-areas-call" secondaryTestid="button-areas-quote" />
  </div>
</PageLayout>
