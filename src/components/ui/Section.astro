---
interface Props {
  background?: "white" | "slate-50" | "slate-100" | "slate-900" | "gradient-dark";
  padding?: "default" | "tight" | "compact";
  testid?: string;
  class?: string;
}

const { background = "white", padding = "default", testid, class: className = "" } = Astro.props;

const backgrounds: Record<string, string> = {
  white: "bg-white",
  "slate-50": "bg-slate-50",
  "slate-100": "bg-slate-100",
  "slate-900": "bg-slate-900",
  "gradient-dark": "bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900",
};

const paddings: Record<string, string> = {
  default: "py-16 lg:py-24",
  tight: "py-16",
  compact: "py-8",
};
---

<section class={`${paddings[padding]} ${backgrounds[background]} ${className}`} data-testid={testid}>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <slot />
  </div>
</section>
