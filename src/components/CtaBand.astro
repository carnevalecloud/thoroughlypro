---
import Button from "./ui/Button.astro";
import { siteInfo } from "../data/siteInfo";

interface Props {
  title?: string;
  titleTestid?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  primaryTestid?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  secondaryTestid?: string;
  background?: "dark" | "light-card";
  testid?: string;
}

const {
  title = "Ready to Transform Your Facility?",
  titleTestid,
  description = "Let's discuss how Thoroughly Pro can help maintain your facility at the highest standards. Give us a call to schedule a walk-through.",
  primaryLabel = `Call ${siteInfo.contact.phone}`,
  primaryHref = siteInfo.contact.phoneUrl,
  primaryTestid,
  secondaryLabel = "Request a Consultation",
  secondaryHref = "/quote",
  secondaryTestid,
  background = "dark",
  testid,
} = Astro.props;

const isDark = background === "dark";
---

<section class={`py-16 ${isDark ? "bg-slate-900" : "bg-slate-50"}`} data-testid={testid}>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class={isDark ? "text-center max-w-2xl mx-auto" : "p-8 lg:p-12 text-center max-w-2xl mx-auto rounded-lg border border-slate-200 bg-white"}>
      <h2 class={`font-bold mb-4 ${isDark ? "text-2xl lg:text-3xl text-white" : "text-2xl text-slate-900"}`} data-testid={titleTestid}>{title}</h2>
      <p class={`mb-8 ${isDark ? "text-slate-300" : "text-slate-600"}`}>{description}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button variant="cta" icon="ph--phone" href={primaryHref} data-testid={primaryTestid}>{primaryLabel}</Button>
        <Button
          variant={isDark ? "outline-light" : "outline-dark"}
          icon="ph--arrow-right"
          iconPosition="right"
          href={secondaryHref}
          data-testid={secondaryTestid}
        >
          {secondaryLabel}
        </Button>
      </div>
    </div>
  </div>
</section>
