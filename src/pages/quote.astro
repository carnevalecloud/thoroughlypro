---
import PageLayout from "../layouts/PageLayout.astro";
import { siteInfo } from "../data/siteInfo";
import Icon from "../components/ui/Icon.astro";
import Button from "../components/ui/Button.astro";
import IconBadge from "../components/ui/IconBadge.astro";

const facilityTypes = [
  "Manufacturing Plant",
  "Warehouse/Distribution Center",
  "Commercial Office",
  "Medical Facility",
  "Food Processing",
  "Retail Space",
  "Other",
];

const serviceTypes = [
  {
    value: "Janitorial / Daily Cleaning",
    icon: "ph--warehouse",
    description: "Routine commercial & industrial cleaning programs",
  },
  {
    value: "Floor Care (Stripping, Waxing & Carpet Cleaning)",
    icon: "ph--stack",
    description: "Floor stripping, rewaxing, and carpet extraction",
  },
  {
    value: "Industrial / Manufacturing Cleaning",
    icon: "ph--factory",
    description: "Production floors, warehouses & facility cleanouts",
  },
  {
    value: "One-Time Deep Clean",
    icon: "ph--package",
    description: "Move-in/move-out, post-construction, or a single deep clean",
  },
];

const squareFootages = ["Under 5,000 sq ft", "5,000 - 15,000 sq ft", "15,000 - 50,000 sq ft", "50,000+ sq ft"];
const frequencies = ["One-Time", "Daily", "Weekly", "Bi-Weekly", "Monthly"];

const quoteSteps = ["Service Type", "Facility Details", "Location & Contact"];
---

<PageLayout
  title="Get a Quote"
  description="Request a consultation for commercial cleaning and facility maintenance services. We'll discuss your needs and create a tailored proposal for your Southern New Hampshire facility."
  keywords="get a quote, request quote, commercial cleaning quote, facility maintenance consultation, Southern New Hampshire"
>
  <div class="min-h-screen bg-background" data-testid="page-quote">
    <section class="py-16 lg:py-24 bg-slate-50" data-testid="section-quote-form">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-12 lg:mb-16">
          <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-4" data-testid="text-quote-title">Let's Talk About Your Facility</h1>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto mb-6">
            The fastest way to get started is to give us a call. We'll schedule a walk-through to understand your specific needs.
          </p>
          <Button variant="cta" icon="ph--phone" href={siteInfo.contact.phoneUrl} data-testid="button-quote-call-top">
            Call {siteInfo.contact.phone}
          </Button>
          <p class="text-sm text-slate-500 mt-4">Or fill out the form below and we'll contact you within 24 hours.</p>
        </div>

        <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
          <div class="lg:col-span-2">
            <div id="quote-form" class="p-8 bg-white rounded-lg shadow-sm border border-slate-200" data-testid="card-quote-form">
              <div class="mb-10" data-testid="quote-progress">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-semibold text-slate-900" id="quote-step-label" data-testid="quote-step-label">
                    Step 1 of {quoteSteps.length}: {quoteSteps[0]}
                  </span>
                  <span class="text-sm text-slate-500" id="quote-step-count">1 / {quoteSteps.length}</span>
                </div>
                <div class="h-2 rounded-full bg-slate-200 overflow-hidden">
                  <div
                    id="quote-progress-bar"
                    class="h-full bg-sky-600 transition-all duration-300 ease-out"
                    style={`width: ${(1 / quoteSteps.length) * 100}%`}
                  />
                </div>
              </div>

              <form action="https://forms.carnevale.cloud/process.php" method="POST" class="space-y-6" id="quote-form-el">
                <input type="hidden" name="form_tools_form_id" value="14" />

                <div class="quote-step space-y-2" data-step="0">
                  <p class="text-sm text-slate-500 mb-4">What type of service does your facility need? <span class="text-red-600">*</span></p>
                  <div class="grid sm:grid-cols-2 gap-4">
                    {serviceTypes.map((type, index) => (
                      <div>
                        <input type="radio" id={`service_type_${index}`} name="service_interest" value={type.value} required class="peer sr-only" />
                        <label
                          for={`service_type_${index}`}
                          class="flex flex-col gap-3 p-5 h-full rounded-lg border-2 border-slate-200 cursor-pointer hover:border-sky-300 peer-checked:border-sky-600 peer-checked:bg-sky-50 transition-colors"
                          data-testid={`option-service-type-${index}`}
                        >
                          <IconBadge icon={type.icon} class="w-11 h-11 rounded-lg bg-sky-100" />
                          <span class="font-semibold text-slate-900">{type.value}</span>
                          <span class="text-sm text-slate-500">{type.description}</span>
                        </label>
                      </div>
                    ))}
                  </div>
                  <p id="service-type-error" class="hidden text-sm text-red-600 mt-2" data-testid="error-service-type">
                    Please select a service type to continue.
                  </p>
                </div>

                <div class="quote-step space-y-6" data-step="1" hidden>
                  <div class="grid md:grid-cols-2 gap-6">
                    <div>
                      <label for="facility_type" class="block text-sm font-medium text-slate-700 mb-1">Facility Type <span class="text-red-600">*</span></label>
                      <select id="facility_type" name="facility_type" required class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="select-facility-type">
                        <option value="">Select facility type</option>
                        {facilityTypes.map((type) => (
                          <option value={type}>{type}</option>
                        ))}
                      </select>
                    </div>
                    <div>
                      <label for="square_footage" class="block text-sm font-medium text-slate-700 mb-1">Approximate Square Footage <span class="text-red-600">*</span></label>
                      <select id="square_footage" name="square_footage" required class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="select-square-footage">
                        <option value="">Select a range</option>
                        {squareFootages.map((range) => (
                          <option value={range}>{range}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                  <div class="grid md:grid-cols-2 gap-6">
                    <div>
                      <label for="cleaning_frequency" class="block text-sm font-medium text-slate-700 mb-1">Desired Cleaning Frequency <span class="text-red-600">*</span></label>
                      <select id="cleaning_frequency" name="cleaning_frequency" required class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="select-frequency">
                        <option value="">Select a frequency</option>
                        {frequencies.map((frequency) => (
                          <option value={frequency}>{frequency}</option>
                        ))}
                      </select>
                    </div>
                    <div>
                      <label for="company" class="block text-sm font-medium text-slate-700 mb-1">Company Name</label>
                      <input type="text" id="company" name="company" placeholder="Your Company" class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="input-company" />
                    </div>
                  </div>
                </div>

                <div class="quote-step space-y-6" data-step="2" hidden>
                  <div>
                    <label for="location" class="block text-sm font-medium text-slate-700 mb-1">Facility City / Town <span class="text-red-600">*</span></label>
                    <input type="text" id="location" name="location" required placeholder="e.g. Keene, NH" class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="input-location" />
                  </div>
                  <div class="grid md:grid-cols-2 gap-6">
                    <div>
                      <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Full Name <span class="text-red-600">*</span></label>
                      <input type="text" id="name" name="name" required minlength="2" placeholder="John Smith" class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="input-name" />
                    </div>
                    <div>
                      <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email Address <span class="text-red-600">*</span></label>
                      <input type="email" id="email" name="email" required placeholder="john@company.com" class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="input-email" />
                    </div>
                  </div>
                  <div>
                    <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">Phone Number <span class="text-red-600">*</span></label>
                    <input type="tel" id="phone" name="phone" required minlength="10" placeholder="(603) 555-1234" class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="input-phone" />
                  </div>
                  <div>
                    <label for="additional_details" class="block text-sm font-medium text-slate-700 mb-1">Additional Details</label>
                    <textarea id="additional_details" name="additional_details" rows="4" placeholder="Tell us about your facility and specific needs..." class="w-full rounded-md border border-slate-300 px-3 py-2 focus:border-sky-500 focus:ring-1 focus:ring-sky-500" data-testid="textarea-message" />
                  </div>
                  <div class="p-4 rounded-lg bg-slate-50 border border-slate-200">
                    <h3 class="text-sm font-semibold text-slate-900 mb-2">Review Your Information</h3>
                    <div id="quote-review-summary" class="text-sm" data-testid="quote-review-summary"></div>
                  </div>
                </div>

                <div class="flex items-center justify-between gap-4 pt-2">
                  <Button type="button" variant="outline-dark" id="quote-back-btn" class="hidden" data-testid="button-quote-back">
                    Back
                  </Button>
                  <div class="flex-1"></div>
                  <Button type="button" variant="cta" icon="ph--arrow-right" iconPosition="right" id="quote-action-btn" data-testid="button-quote-action">
                    <span id="quote-action-label">Continue</span>
                  </Button>
                </div>
              </form>
            </div>

            <script>
              const steps = Array.from(document.querySelectorAll<HTMLElement>(".quote-step"));
              const backBtn = document.getElementById("quote-back-btn") as HTMLButtonElement | null;
              const actionBtn = document.getElementById("quote-action-btn") as HTMLButtonElement | null;
              const actionLabel = document.getElementById("quote-action-label");
              const stepLabel = document.getElementById("quote-step-label");
              const stepCount = document.getElementById("quote-step-count");
              const progressBar = document.getElementById("quote-progress-bar");
              const serviceTypeError = document.getElementById("service-type-error");
              const form = document.getElementById("quote-form-el") as HTMLFormElement | null;
              const stepLabels = ["Service Type", "Facility Details", "Location & Contact"];
              let currentStep = 0;

              function fieldValue(name: string) {
                const el = form?.elements.namedItem(name);
                if (!el) return "";
                if (el instanceof RadioNodeList) {
                  const checked = Array.from(el).find((n) => (n as HTMLInputElement).checked) as HTMLInputElement | undefined;
                  return checked?.value || "";
                }
                if (el instanceof HTMLSelectElement) return el.selectedOptions[0]?.textContent?.trim() || "";
                if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) return el.value.trim();
                return "";
              }

              function populateReview() {
                const summary = document.getElementById("quote-review-summary");
                if (!summary) return;
                summary.replaceChildren();
                const rows: [string, string][] = [
                  ["Service Type", fieldValue("service_interest")],
                  ["Facility Type", fieldValue("facility_type")],
                  ["Square Footage", fieldValue("square_footage")],
                  ["Frequency", fieldValue("cleaning_frequency")],
                  ["Company", fieldValue("company") || "—"],
                  ["Location", fieldValue("location")],
                  ["Name", fieldValue("name")],
                  ["Email", fieldValue("email")],
                  ["Phone", fieldValue("phone")],
                ];
                for (const [label, value] of rows) {
                  const row = document.createElement("div");
                  row.className = "flex justify-between gap-4 py-1.5 border-b border-slate-200 last:border-0";
                  const labelEl = document.createElement("span");
                  labelEl.className = "text-slate-500";
                  labelEl.textContent = label;
                  const valueEl = document.createElement("span");
                  valueEl.className = "font-medium text-slate-900 text-right";
                  valueEl.textContent = value;
                  row.append(labelEl, valueEl);
                  summary.appendChild(row);
                }
              }

              function showStep(index: number) {
                steps.forEach((step, i) => {
                  step.hidden = i !== index;
                });
                const isLast = index === steps.length - 1;
                backBtn?.classList.toggle("hidden", index === 0);
                if (actionLabel) actionLabel.textContent = isLast ? "Request Free Consultation" : "Continue";
                if (actionBtn) actionBtn.type = isLast ? "submit" : "button";
                if (stepLabel) stepLabel.textContent = `Step ${index + 1} of ${steps.length}: ${stepLabels[index]}`;
                if (stepCount) stepCount.textContent = `${index + 1} / ${steps.length}`;
                if (progressBar) progressBar.style.width = `${((index + 1) / steps.length) * 100}%`;
                if (isLast) populateReview();
                currentStep = index;
              }

              function validateStep(index: number) {
                const container = steps[index];
                if (!container) return true;

                if (index === 0) {
                  const checked = container.querySelector('input[name="service_interest"]:checked');
                  serviceTypeError?.classList.toggle("hidden", !!checked);
                  return !!checked;
                }

                const invalid = container.querySelector<HTMLElement>(":invalid");
                if (invalid && "reportValidity" in invalid) {
                  (invalid as HTMLInputElement).reportValidity();
                  return false;
                }
                return true;
              }

              actionBtn?.addEventListener("click", () => {
                if (currentStep === steps.length - 1) return;
                if (!validateStep(currentStep)) return;
                showStep(Math.min(currentStep + 1, steps.length - 1));
              });

              backBtn?.addEventListener("click", () => {
                showStep(Math.max(currentStep - 1, 0));
              });

              form?.addEventListener("input", () => {
                if (currentStep === steps.length - 1) populateReview();
              });

              // Handle URL params prefilling
              const urlParams = new URLSearchParams(window.location.search);
              const locParam = urlParams.get("location") || urlParams.get("area") || urlParams.get("town");
              if (locParam) {
                const locInput = document.getElementById("location") as HTMLInputElement | null;
                if (locInput) locInput.value = locParam;
              }
              const serviceParam = urlParams.get("service");
              if (serviceParam) {
                const matchingRadio = Array.from(
                  document.querySelectorAll<HTMLInputElement>('input[name="service_interest"]')
                ).find((radio) => radio.value.toLowerCase().includes(serviceParam.toLowerCase()));
                if (matchingRadio) matchingRadio.checked = true;
              }

              showStep(0);
            </script>
          </div>

          <div class="space-y-6">
            <div class="p-6 bg-slate-900 text-white rounded-lg" data-testid="card-contact-info">
              <h3 class="text-lg font-semibold mb-6">Contact Information</h3>
              <div class="space-y-4">
                <a href={siteInfo.contact.phoneUrl} class="flex items-center gap-3 text-slate-300 hover:text-white transition-colors" data-testid="link-quote-phone">
                  <IconBadge icon="ph--phone" class="w-10 h-10 rounded-lg bg-green-600" iconClass="w-5 h-5 text-white" />
                  <div>
                    <p class="text-sm text-slate-400">Call Us</p>
                    <p class="font-medium">{siteInfo.contact.phone}</p>
                  </div>
                </a>
                <a href={`mailto:${siteInfo.contact.email}`} class="flex items-center gap-3 text-slate-300 hover:text-white transition-colors" data-testid="link-quote-email">
                  <IconBadge icon="ph--envelope-simple" class="w-10 h-10 rounded-lg bg-sky-600" iconClass="w-5 h-5 text-white" />
                  <div>
                    <p class="text-sm text-slate-400">Email Us</p>
                    <p class="font-medium text-sm">{siteInfo.contact.email}</p>
                  </div>
                </a>
                <a href={siteInfo.contact.address.mapsLink} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-300 hover:text-white transition-colors" data-testid="link-quote-address">
                  <IconBadge icon="ph--map-pin" class="w-10 h-10 rounded-lg bg-slate-700" iconClass="w-5 h-5 text-white" />
                  <div>
                    <p class="text-sm text-slate-400">Location</p>
                    <p class="font-medium text-sm">
                      {siteInfo.contact.address.line1}<br />
                      {siteInfo.contact.address.line2}
                    </p>
                  </div>
                </a>
              </div>
            </div>
            <div class="p-6 bg-green-50 border border-green-200 rounded-lg" data-testid="card-response-time">
              <div class="flex items-start gap-4">
                <Icon name="ph--clock" class="w-6 h-6 text-green-600" />
                <div>
                  <h4 class="font-semibold text-slate-900 mb-1">Quick Response</h4>
                  <p class="text-sm text-slate-600">We respond to all inquiries within 24 hours during business days.</p>
                </div>
              </div>
            </div>
            <div class="p-6 rounded-lg border border-slate-200 bg-white" data-testid="card-what-to-expect">
              <h4 class="font-semibold text-slate-900 mb-4">What to Expect</h4>
              <ul class="space-y-3">
                {["Initial phone consultation", "Free on-site walk-through", "Customized maintenance proposal", "Flexible scheduling options"].map((item) => (
                  <li class="flex items-center gap-3 text-sm text-slate-600">
                    <Icon name="ph--check-circle" class="w-4 h-4 text-green-500" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</PageLayout>
