---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import MobileCtaBar from "../components/MobileCtaBar.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
}

const { title, description, image, keywords } = Astro.props;
---

<Layout title={title} description={description} image={image} keywords={keywords}>
  <Navbar />
  <main class="pb-20 md:pb-0">
    <slot />
  </main>
  <Footer />
  <MobileCtaBar />
</Layout>
