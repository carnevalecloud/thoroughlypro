---
import PageLayout from "../../layouts/PageLayout.astro";
import { services } from "../../data/services";
import Icon from "../../components/ui/Icon.astro";
import Button from "../../components/ui/Button.astro";
import IconBadge from "../../components/ui/IconBadge.astro";
import PageHero from "../../components/PageHero.astro";

export async function getStaticPaths() {
  return services.map((service) => ({ params: { id: service.id } }));
}

const { id } = Astro.params;
const service = services.find((s) => s.id === id);

const trustPoints = [
  { icon: "ph--trophy", color: "green", title: "40+ Years Experience", description: "Serving industrial and commercial clients since 1983" },
  { icon: "ph--shield", color: "sky", title: "Fully Insured", description: "Complete liability coverage for your peace of mind" },
  { icon: "ph--clock", color: "amber", title: "Flexible Scheduling", description: "Work around your operations with minimal disruption" },
];

const badgeColors: Record<string, string> = {
  green: "bg-green-100",
  sky: "bg-sky-100",
  amber: "bg-amber-100",
};
const iconColors: Record<string, string> = {
  green: "text-green-600",
  sky: "text-sky-600",
  amber: "text-amber-600",
};
---

{service ? (
  <PageLayout title={service.title} description={service.shortDesc} image={`/images/services/${service.id}.png`} keywords={service.keywords}>
    <div class="min-h-screen bg-background" data-testid={`page-service-${service.id}`}>
      <PageHero
        testid="section-service-hero"
        titleTestid="text-service-title"
        title={service.title}
        description={service.shortDesc}
        image={`/images/services/${service.id}.png`}
      >
        <IconBadge
          slot="eyebrow"
          icon={service.icon}
          class="w-20 h-20 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 mx-auto mb-6"
          iconClass="w-10 h-10 text-white"
        />
      </PageHero>

      <section class="py-16 lg:py-24 bg-white" data-testid="section-service-details">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <div class="grid lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-12">
              <div>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">About This Service</h2>
                <p class="text-lg text-slate-600 leading-relaxed">{service.fullDesc}</p>
              </div>

              <div class="p-8 bg-slate-50 rounded-lg">
                <h2 class="text-2xl font-bold text-slate-900 mb-6">What's Included</h2>
                <ul class="grid md:grid-cols-2 gap-4">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-3 text-slate-700">
                      <Icon name="ph--check-circle" class="w-4 h-4 text-green-500 flex-shrink-0" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h2 class="text-2xl font-bold text-slate-900 mb-6">Who This Service Is For</h2>
                <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
                  {service.targetAudiences.map((audience) => (
                    <div class="flex items-center gap-2 px-4 py-3 bg-sky-50 rounded-lg text-slate-700">
                      <Icon name="ph--check-circle" class="w-4 h-4 text-sky-600 flex-shrink-0" />
                      {audience}
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="lg:col-span-1">
              <div class="p-8 shadow-lg sticky top-32 z-40 rounded-lg border border-slate-200 bg-white">
                <h2 class="text-xl font-bold text-slate-900 mb-3">Ready to Transform Your Facility?</h2>
                <p class="text-slate-600 mb-6">Give us a call to schedule a walk-through and discuss your needs.</p>
                <div class="space-y-3">
                  <Button variant="cta" icon="ph--arrow-right" iconPosition="right" href="/quote" class="w-full" data-testid="button-service-quote">
                    Request a Quote
                  </Button>
                  <Button variant="outline-dark" icon="ph--phone" href="tel:6034968229" class="w-full" data-testid="button-service-call">
                    (603) 496-8229
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 bg-slate-50" data-testid="section-trust-building">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-4 text-center">Why Choose Thoroughly Pro</h2>
          <p class="text-slate-600 text-center max-w-2xl mx-auto mb-12">Trusted by Southern NH facilities since 1983</p>
          <div class="grid md:grid-cols-3 gap-6 mb-12">
            {trustPoints.map((point) => (
              <div class="p-6 text-center rounded-lg border border-slate-200 bg-white">
                <IconBadge
                  icon={point.icon}
                  class={`w-12 h-12 rounded-full ${badgeColors[point.color]} mx-auto mb-4`}
                  iconClass={`w-6 h-6 ${iconColors[point.color]}`}
                />
                <h3 class="font-bold text-slate-900 mb-2">{point.title}</h3>
                <p class="text-sm text-slate-600">{point.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="py-16 bg-white" data-testid="section-other-services">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-8 text-center">Other Services</h2>
          <div class="grid md:grid-cols-3 gap-6">
            {services.filter((s) => s.id !== service.id).slice(0, 3).map((other) => (
              <a href={`/services/${other.id}`}>
                <div class="p-6 rounded-lg border border-slate-200 hover-elevate cursor-pointer h-full">
                  <IconBadge icon={other.icon} class="w-12 h-12 rounded-lg bg-sky-100 mb-4" />
                  <h3 class="font-bold text-slate-900 mb-2">{other.title}</h3>
                  <p class="text-sm text-slate-600">{other.shortDesc}</p>
                </div>
              </a>
            ))}
          </div>
          <div class="text-center mt-8">
            <Button variant="outline-dark" icon="ph--arrow-left" href="/services" data-testid="button-view-all-services">
              View All Services
            </Button>
          </div>
        </div>
      </section>
    </div>
  </PageLayout>
) : (
  <PageLayout title="Service Not Found" description="The service you're looking for doesn't exist." keywords="Thoroughly Pro, commercial cleaning, services">
    <div class="min-h-screen bg-background flex items-center justify-center">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
        <h1 class="text-3xl font-bold text-slate-900 mb-4">Service Not Found</h1>
        <p class="text-slate-600 mb-8">The service you're looking for doesn't exist.</p>
        <Button variant="primary" icon="ph--arrow-left" href="/services">
          Back to Services
        </Button>
      </div>
    </div>
  </PageLayout>
)}
