---
import PageLayout from "../../layouts/PageLayout.astro";
import { services } from "../../data/services";
import Button from "../../components/ui/Button.astro";
import Section from "../../components/ui/Section.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceCard from "../../components/ServiceCard.astro";
---

<PageLayout
  title="Our Services"
  description="Tailored cleaning and maintenance solutions for industrial manufacturing facilities across Southern New Hampshire. Commercial cleaning, facility cleanouts, carpet cleaning, and floor care."
  keywords="commercial cleaning services, industrial cleaning, facility cleanouts, carpet cleaning, floor stripping, floor waxing, Southern New Hampshire"
>
  <div class="min-h-screen bg-background" data-testid="page-services">
    <PageHero
      testid="section-services-hero"
      titleTestid="text-services-hero-title"
      title="Our Services"
      description="Tailored cleaning and maintenance solutions for industrial manufacturing facilities. We listen first, then deliver."
      image="/images/hero.png"
    />

    <Section testid="section-services-list">
      <div class="grid md:grid-cols-2 gap-6">
        {services.map((service) => (
          <ServiceCard service={service} variant="list" />
        ))}
      </div>

      <div class="mt-16 text-center bg-slate-900 rounded-xl p-10">
        <h2 class="text-2xl lg:text-3xl font-bold text-white mb-4">Need a Custom Solution?</h2>
        <p class="text-slate-300 mb-6 max-w-2xl mx-auto">
          Every facility is unique. Contact us to discuss your specific requirements and we'll create a tailored maintenance plan just for you.
        </p>
        <Button variant="cta" icon="ph--arrow-right" iconPosition="right" href="/quote" data-testid="button-services-quote">
          Request a Consultation
        </Button>
      </div>
    </Section>
  </div>
</PageLayout>
